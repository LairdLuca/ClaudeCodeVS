<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Cleared on purpose. This project needs nothing but nuget.org, and a machine-wide
       configuration that lists an authenticated feed makes a non-interactive restore hang
       waiting for credentials instead of failing with an error. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
