<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidClaudeCodePackage">

    <Groups>
      <!-- Group hosted in the Tools menu -->
      <Group guid="guidClaudeCodeCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <!-- Same commands on the editor right-click menu -->
      <Group guid="guidClaudeCodeCmdSet" id="EditorContextGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidClaudeCodeCmdSet" id="cmdidSendSelection" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>Send Selection to Claude Code</ButtonText>
          <CommandName>ClaudeCode.SendSelection</CommandName>
        </Strings>
      </Button>
      <Button guid="guidClaudeCodeCmdSet" id="cmdidSendSelectionCtx" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="EditorContextGroup" />
        <Strings>
          <ButtonText>Send Selection to Claude Code</ButtonText>
          <CommandName>ClaudeCode.SendSelectionFromEditor</CommandName>
        </Strings>
      </Button>
      <Button guid="guidClaudeCodeCmdSet" id="cmdidShowStatus" priority="0x0200" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>Claude Code: Connection Status</ButtonText>
          <CommandName>ClaudeCode.Status</CommandName>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidClaudeCodeCmdSet" id="cmdidSendSelectionCtx"
                editor="guidVSStd97" key1="K" mod1="Control Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidClaudeCodePackage" value="{96A4CDA8-6BCF-4D9C-BBA9-72EF24E65400}" />

    <GuidSymbol name="guidClaudeCodeCmdSet" value="{B237E1C0-61F3-4A16-A522-899C13BF2395}">
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="EditorContextGroup" value="0x1021" />
      <IDSymbol name="cmdidSendSelection" value="0x0100" />
      <IDSymbol name="cmdidSendSelectionCtx" value="0x0101" />
      <IDSymbol name="cmdidShowStatus" value="0x0102" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
